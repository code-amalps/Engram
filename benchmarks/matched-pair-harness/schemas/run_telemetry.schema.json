{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engram.dev/schemas/run_telemetry.v2.json",
  "title": "Engram Benchmark Run Telemetry v2",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "pair_id",
    "task_id",
    "arm",
    "execution_order_in_pair",
    "timestamps",
    "model",
    "isolation",
    "telemetry",
    "git_impact",
    "correctness"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2.0.0" },
    "run_id": { "type": "string" },
    "pair_id": { "type": "string" },
    "task_id": { "type": "string" },
    "arm": { "type": "string", "enum": ["control_A", "treatment_B", "baseline_arm1", "v151_arm2", "v154_arm3", "arm_a_native", "arm_b_cand3", "arm_b_cand3_always_on", "arm_c_cand4_always_on", "arm_c_cand42_always_on", "arm_d_cand4_adaptive", "arm_d_cand42_adaptive", "arm_e_cand5_optimized"] },
    "execution_order_in_pair": { "type": "integer", "minimum": 1, "maximum": 10 },
    "execution_status": { "type": "string" },
    "error_message": { "type": ["string", "null"] },
    "timestamps": {
      "type": "object",
      "required": ["started_at", "completed_at", "elapsed_seconds"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "elapsed_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "model": {
      "type": "object",
      "required": ["provider", "name", "mode", "reasoning_effort", "harness_executable"],
      "properties": {
        "provider": { "type": "string" },
        "name": { "type": "string" },
        "mode": { "type": "string" },
        "reasoning_effort": { "type": "string" },
        "harness_executable": { "type": "string" },
        "harness_version": { "type": "string" }
      }
    },
    "isolation": {
      "type": "object",
      "required": [
        "baseline_commit",
        "sandbox_path",
        "cold_start_verified",
        "engram_enabled",
        "engram_binary_sha256",
        "dependency_fingerprint_verified",
        "path_sanitized"
      ],
      "properties": {
        "baseline_commit": { "type": "string" },
        "sandbox_path": { "type": "string" },
        "cold_start_verified": { "type": "boolean" },
        "engram_enabled": { "type": "boolean" },
        "engram_binary_sha256": { "type": "string" },
        "engram_binary_expected_sha256": { "type": ["string", "null"] },
        "engram_binary_actual_sha256": { "type": ["string", "null"] },
        "engram_binary_path": { "type": ["string", "null"] },
        "benchmark_candidate_version": { "type": ["string", "null"] },
        "requested_candidate_version": { "type": ["string", "null"] },
        "resolved_candidate_version": { "type": ["string", "null"] },
        "candidate_verification_status": { "type": ["string", "null"] },
        "mcp_registration_verified": { "type": ["boolean", "null"] },
        "mcp_server_status": { "type": "string" },
        "dependency_fingerprint_verified": { "type": "boolean" },
        "path_sanitized": { "type": "boolean" },
        "sandbox_policy": { "type": "string" }
      }
    },
    "telemetry": {
      "type": "object",
      "required": [
        "provenance",
        "prompt_tokens_total",
        "prompt_tokens_cached",
        "prompt_tokens_cached_inferred",
        "prompt_tokens_uncached",
        "prompt_tokens_uncached_inferred",
        "completion_tokens",
        "reasoning_tokens",
        "total_model_tokens",
        "turns_count",
        "mcp_tool_calls_count",
        "auxiliary_tool_payload_bytes"
      ],
      "properties": {
        "provenance": { "type": "string", "enum": ["DIRECT_API", "HARNESS_LOG", "UI_COUNTER", "SYNTHETIC_TEST", "SESSION_ROLLOUT", "UNAVAILABLE"] },
        "telemetry_valid": { "type": "boolean" },
        "prompt_tokens_total": { "type": "integer", "minimum": 0 },
        "prompt_tokens_cached": { "type": "integer", "minimum": 0 },
        "prompt_tokens_cached_inferred": { "type": "boolean" },
        "prompt_tokens_uncached": { "type": "integer", "minimum": 0 },
        "prompt_tokens_uncached_inferred": { "type": "boolean" },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": "integer", "minimum": 0 },
        "total_model_tokens": { "type": "integer", "minimum": 0 },
        "peak_single_request_context": { "type": ["integer", "null"] },
        "peak_turn_context": { "type": ["integer", "null"] },
        "final_turn_context": { "type": ["integer", "null"] },
        "model_requests_count": { "type": ["integer", "null"] },
        "turns_count": { "type": "integer", "minimum": 0 },
        "mcp_tool_calls_count": { "type": "integer", "minimum": 0 },
        "auxiliary_tool_payload_bytes": { "type": "integer", "minimum": 0 },
        "account_usage_reading_start_pct": { "type": ["integer", "null"] },
        "account_usage_reading_end_pct": { "type": ["integer", "null"] },
        "replacement_accounting": {
          "type": ["object", "null"],
          "properties": {
            "files_retrieved_via_engram": { "type": "array", "items": { "type": "string" } },
            "files_read_via_shell": { "type": "array", "items": { "type": "string" } },
            "files_repeated_read": { "type": "array", "items": { "type": "string" } },
            "engram_excerpts_count": { "type": "integer", "minimum": 0 },
            "engram_excerpts_reread_count": { "type": "integer", "minimum": 0 },
            "serialized_invocations_bytes": { "type": "integer", "minimum": 0 },
            "serialized_responses_bytes": { "type": "integer", "minimum": 0 },
            "inner_response_content_bytes": { "type": "integer", "minimum": 0 },
            "serialized_jsonrpc_response_bytes": { "type": "integer", "minimum": 0 },
            "max_individual_response_bytes": { "type": "integer", "minimum": 0 },
            "aggregate_auxiliary_payload_bytes": { "type": "integer", "minimum": 0 },
            "estimated_payload_tokens": { "type": "integer", "minimum": 0 },
            "replacement_status": { "type": "string", "enum": ["MEASURED", "ESTIMATED", "UNKNOWN", "NOT_OBSERVABLE"] },
            "tokens_per_successful_task": { "type": ["number", "null"] }
          }
        },
        "round_trip_summary": {
          "type": ["object", "null"],
          "properties": {
            "total_agent_turns": { "type": "integer", "minimum": 0 },
            "total_round_trips": { "type": "integer", "minimum": 0 },
            "engram_mcp_calls": { "type": "integer", "minimum": 0 },
            "standard_tool_calls": { "type": "integer", "minimum": 0 },
            "total_retries": { "type": "integer", "minimum": 0 },
            "latency_mean_ms": { "type": "number", "minimum": 0 },
            "latency_median_ms": { "type": "number", "minimum": 0 },
            "latency_p95_ms": { "type": "number", "minimum": 0 },
            "latency_min_ms": { "type": "number", "minimum": 0 },
            "latency_max_ms": { "type": "number", "minimum": 0 },
            "total_request_bytes": { "type": "integer", "minimum": 0 },
            "total_response_bytes": { "type": "integer", "minimum": 0 },
            "adaptive_bypass_count": { "type": "integer", "minimum": 0 },
            "status": { "type": "string" }
          }
        },
        "round_trip_events": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "properties": {
              "call_id": { "type": "string" },
              "tool_name": { "type": "string" },
              "is_engram": { "type": "boolean" },
              "is_retry": { "type": "boolean" },
              "attempt_number": { "type": "integer", "minimum": 1 },
              "request_bytes": { "type": "integer", "minimum": 0 },
              "response_bytes": { "type": "integer", "minimum": 0 },
              "duration_ms": { "type": "number", "minimum": 0 },
              "status": { "type": "string" },
              "timestamp": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "git_impact": {
      "type": "object",
      "required": ["files_changed_count", "files_changed", "insertions", "deletions", "unrelated_files_count"],
      "properties": {
        "files_changed_count": { "type": "integer", "minimum": 0 },
        "files_changed": { "type": "array", "items": { "type": "string" } },
        "insertions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "unrelated_files_count": { "type": "integer", "minimum": 0 },
        "diff_patch_path": { "type": "string" }
      }
    },
    "correctness": {
      "type": "object",
      "required": ["score", "quality_adjusted_cost", "passed_all_requirements", "gates", "requirements"],
      "properties": {
        "score": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
        "quality_adjusted_cost": { "type": ["number", "null"], "minimum": 0 },
        "passed_all_requirements": { "type": ["boolean", "null"] },
        "gates": {
          "type": "object",
          "properties": {
            "L0_typecheck": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED"] },
            "L1_lint_prettier": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED"] },
            "L2_unit_tests": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED"] },
            "L3_production_build": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED"] }
          }
        },
        "requirements": {
          "type": "object",
          "additionalProperties": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "NOT_EVALUATED"] }
        }
      }
    },
    "headroom_guard": {
      "type": "object",
      "properties": {
        "headroom_reserve": { "type": "integer", "minimum": 0 },
        "pre_dispatch_guard_triggered": { "type": "boolean" },
        "stop_reason": { "type": ["string", "null"] },
        "cumulative_tokens_at_stop": { "type": ["integer", "null"] },
        "estimated_next_turn_cost": { "type": ["integer", "null"] },
        "configured_ceiling": { "type": ["integer", "null"] },
        "remaining_budget": { "type": ["integer", "null"] },
        "last_turn_usage": { "type": ["integer", "null"] },
        "guard_decision": { "type": ["string", "null"] },
        "timestamp": { "type": ["string", "null"] },
        "relevant_event_id": { "type": ["string", "null"] },
        "telemetry_valid": { "type": ["boolean", "null"] }
      }
    },
    "adaptive_activation": {
      "type": ["object", "null"],
      "properties": {
        "tier": { "type": "string" },
        "routed_mode": { "type": "string" },
        "reasoning": { "type": "string" },
        "execution_time_ms": { "type": "number" },
        "signals": { "type": "object" },
        "override_applied": { "type": ["string", "null"] },
        "escalation_count": { "type": "integer" },
        "escalation_history": { "type": "array" }
      }
    },
    "request_size_gate": {
      "type": ["object", "null"],
      "properties": {
        "gate_passed": { "type": "boolean" },
        "measured_request_tokens": { "type": "integer", "minimum": 0 },
        "measured_request_bytes": { "type": "integer", "minimum": 0 },
        "counting_method": { "type": "string" },
        "limit_tokens": { "type": "integer", "minimum": 0 },
        "breakdown": { "type": ["object", "null"] }
      }
    }
  }
}
