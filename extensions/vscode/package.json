{
  "name": "engram",
  "displayName": "Engram — Engineering Memory & Change Intelligence",
  "description": "Local engineering memory, context compilation, and Change Contract guard for AI coding agents.",
  "version": "1.5.1",
  "type": "commonjs",
  "publisher": "code-amalps",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/code-amalps/Engram.git",
    "directory": "extensions/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "engram",
    "engineering memory",
    "change contract",
    "context",
    "ai agents"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onCommand:engram.checkHealth",
    "onCommand:engram.locateBinary",
    "onCommand:engram.showOutputChannel",
    "onCommand:engram.compileContext",
    "onCommand:engram.copyContext",
    "onCommand:engram.refreshMemories",
    "onCommand:engram.showMemoryDetails",
    "onView:engram.views.memories",
    "workspaceContains:.engram"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "engram-explorer",
          "title": "Engram",
          "icon": "resources/engram.svg"
        }
      ]
    },
    "views": {
      "engram-explorer": [
        {
          "id": "engram.views.memories",
          "name": "Engineering Memories"
        }
      ]
    },
    "commands": [
      {
        "command": "engram.checkHealth",
        "title": "Check Health (Doctor)",
        "category": "Engram"
      },
      {
        "command": "engram.locateBinary",
        "title": "Locate Binary",
        "category": "Engram"
      },
      {
        "command": "engram.showOutputChannel",
        "title": "Show Output Channel",
        "category": "Engram"
      },
      {
        "command": "engram.compileContext",
        "title": "Compile Context",
        "category": "Engram",
        "icon": "$(sparkle)"
      },
      {
        "command": "engram.copyContext",
        "title": "Copy Compiled Context",
        "category": "Engram",
        "icon": "$(copy)"
      },
      {
        "command": "engram.refreshMemories",
        "title": "Refresh Memories",
        "category": "Engram",
        "icon": "$(refresh)"
      },
      {
        "command": "engram.showMemoryDetails",
        "title": "Show Memory Details",
        "category": "Engram"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "engram.compileContext",
          "when": "view == engram.views.memories",
          "group": "navigation@1"
        },
        {
          "command": "engram.refreshMemories",
          "when": "view == engram.views.memories",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "engram.showMemoryDetails",
          "when": "view == engram.views.memories && viewItem == durableMemory"
        }
      ]
    },
    "configuration": {
      "title": "Engram",
      "properties": {
        "engram.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Explicit absolute path to the engram executable. If set, Engram will only use this binary and will not fall back to other paths if invalid."
        },
        "engram.timeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "Execution timeout in milliseconds for engram CLI commands."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "test": "mocha --require ./test/setup.js --timeout 15000 out/test/**/*.test.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/vsce": "^3.2.1",
    "eslint": "^8.57.1",
    "mocha": "^10.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
